{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/backend/src",
  "projectType": "application",
  "tags": ["scope:backend"],
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "target": "node",
        "compiler": "tsc",
        "outputPath": "dist/apps/backend",
        "main": "apps/backend/src/main.ts",
        "additionalEntryPoints": [
          {
            "entryName": "seed",
            "entryPath": "apps/backend/src/seed/seed.ts"
          }
        ],
        "tsConfig": "apps/backend/tsconfig.app.json",
        "webpackConfig": "apps/backend/webpack.config.js",
        "generatePackageJson": true,
        "assets": []
      },
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "backend:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "backend:build:development"
        },
        "production": {
          "buildTarget": "backend:build:production"
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome check {projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config apps/backend/vitest.config.ts"
      }
    },
    "test-integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config apps/backend/vitest.integration.config.ts"
      }
    },
    "seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r @swc-node/register apps/backend/src/seed/seed.ts",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
