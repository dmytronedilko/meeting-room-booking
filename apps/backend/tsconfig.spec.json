{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "types": ["vitest/globals", "node"],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "es2021"
  },
  "include": [
    "vitest.config.ts",
    "vitest.integration.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.d.ts",
    "e2e/**/*.ts"
  ]
}
