# PostgreSQL (used by the docker compose `db` service and by the app in dev mode)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=booking

# Backend
# Dev mode connects to the dockerized db on localhost:5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/booking?schema=public
JWT_SECRET=change-me-in-production
JWT_TTL=24h
# Base URL of the app, used to build the email-confirmation link written to the server log
APP_URL=http://localhost:3000
# Set to true when the app is served over HTTPS (adds Secure to the session cookie)
COOKIE_SECURE=false
PORT=3001
LOG_LEVEL=info
# Throttler for /auth/* (requests per minute per IP)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=10
# Minutes before a booking ends to send the "ends soon" notification
NOTIFY_BEFORE_MINUTES=10

# Frontend (dev mode talks to the API directly; in Docker it is baked to /api at build time)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Integration tests (separate database, created automatically by infra/db/init-test-db.sql)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/booking_test?schema=public
