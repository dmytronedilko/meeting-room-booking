generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Prisma 7 is engine-free: the connection is supplied by the `pg` driver
  // adapter (see PrismaService) at runtime and by `prisma.config.ts` for the
  // CLI (migrate/introspect). The URL no longer lives in the schema.
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  // Case-sensitive unique index (User_email_key) is Prisma-managed; case-insensitive
  // uniqueness is additionally enforced at the DB level by a functional unique index on
  // lower(email) — raw-SQL migration 20260801000000_email_case_insensitive_unique.
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  // Dev-mode email confirmation: null until the user clicks the logged link.
  // Booking creation is blocked while unconfirmed.
  emailConfirmedAt  DateTime? @db.Timestamptz(3)
  // The pending confirmation token (null once confirmed); unique so a link
  // resolves to exactly one user.
  emailConfirmToken String?   @unique
  bookings     Booking[]
}

model Room {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  floor     Int
  capacity  Int
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  bookings  Booking[]
}

model Booking {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @db.Uuid
  userId    String   @db.Uuid
  title     String   @db.VarChar(100)
  startsAt  DateTime @db.Timestamptz(3)
  endsAt    DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  // Non-null for occurrences created together as a weekly recurring series;
  // every occurrence in a series shares the same value.
  seriesId  String?  @db.Uuid
  // When the "ends soon" notification was sent (null until sent), so the
  // background scheduler never notifies the same booking twice.
  endNotifiedAt DateTime? @db.Timestamptz(3)
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, startsAt])
  @@index([userId, startsAt])
  @@index([seriesId])
  @@index([endNotifiedAt, endsAt])
}
