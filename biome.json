{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "assist": { "enabled": false },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/coverage",
      "!**/.next",
      "!**/next-env.d.ts",
      "!**/.nx",
      "!**/playwright-report",
      "!**/test-results",
      "!**/*.css",
      "!apps/backend/prisma/migrations",
      "!infra/grafana/dashboards"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "error" },
      "correctness": { "noUnusedVariables": "error" }
    }
  },
  "overrides": [
    {
      "includes": ["apps/backend/**"],
      "linter": {
        "rules": {
          "complexity": { "useLiteralKeys": "off" },
          "correctness": { "useHookAtTopLevel": "off" },
          "style": { "useImportType": "off" }
        }
      }
    }
  ]
}
